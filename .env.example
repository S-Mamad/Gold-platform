# Copy to .env before docker compose. Production refuses placeholder secrets.

POSTGRES_USER=gold
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=gold_trading

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY
CORS_ORIGIN=https://your-domain.com

# Local demo only. Leave false when a real feed and bank are configured.
GOLD_ALLOW_SIMULATED=false
GOLD_PRICE_SOURCE=http
GOLD_PRICE_URL=https://example.invalid/gold.json
PAYMENT_MODE=gateway
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
KYC_MODE=live
COOKIE_SECURE=true
