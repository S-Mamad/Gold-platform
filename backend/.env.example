# PostgreSQL
DATABASE_URL=postgresql://gold:gold_secret_change_me@localhost:5432/gold_trading?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Gold pricing. simulated is local only. Production needs GOLD_PRICE_SOURCE=http
# or an explicit GOLD_ALLOW_SIMULATED=true.
GOLD_PRICE_SOURCE=simulated
GOLD_PRICE_URL=
GOLD_PRICE_MAX_AGE_SECONDS=180
GOLD_ALLOW_SIMULATED=false
GOLD_PRICE_FREEZE_SECONDS=120
DEFAULT_GOLD_PRICE=4250000
BUY_SPREAD_BPS=50
SELL_SPREAD_BPS=50
FEE_BPS=20

# Auth. Replace both before NODE_ENV=production.
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=change_me_admin_key
COOKIE_SECURE=false

# sandbox credits a local balance. gateway waits for a signed callback.
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=
KYC_MODE=mock

CORS_ORIGIN=http://localhost:3000,http://localhost:3010

# Dev only. Ignored when NODE_ENV=production.
EXPOSE_DEV_OTP=true
SMS_URL=
NODE_ENV=development
PORT=3001
